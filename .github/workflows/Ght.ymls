name: Tailscale Exit Node (Windows)

on:
  schedule:
    - cron: '0 */6 * * *'
  workflow_dispatch:

jobs:
  vpn-exit-node:
    runs-on: windows-latest
    steps:
      # 1. Enable IP Forwarding (PowerShell)
      # REQUIRED: This loops through all adapters to ensure the VPN can route traffic.
      - name: Enable IP Forwarding
        run: |
          Get-NetIPInterface | ForEach-Object { Set-NetIPInterface -InterfaceIndex $_.InterfaceIndex -Forwarding Enabled }
        shell: powershell

      # 2. Connect to Tailscale
      - name: Connect to Tailscale
        uses: tailscale/github-action@v4
        with:
          oauth-client-id: ${{ secrets.TS_OAUTH_CLIENT_ID }}
          oauth-secret: ${{ secrets.TS_OAUTH_SECRET }}
          tags: tag:p
          # FIX: Only use these two flags. 
          # Do not use --unattended or --hostname to prevent Exit Code 2.
          args: --advertise-exit-node --ephemeral

      # 3. Keep Alive (Max 6 hours)
      - name: Keep Connection Alive
        timeout-minutes: 360
        run: |
          Write-Host "Tailscale Exit Node is active."
          Write-Host "This runner will remain active for approx 6 hours."
          Start-Sleep -Seconds 21300
        shell: powershell
